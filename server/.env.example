# ===== ตัวอย่างการตั้งค่า (คัดลอกเป็น .env แล้วแก้ค่า) — ห้าม commit .env จริง =====

# --- storage ---
# local = ทดสอบในเครื่อง (ไม่ต้องมี Drive), drive = ใช้จริงกับ Shared Drive
STORAGE_BACKEND=local
LOCAL_ROOT=./_data
# ใช้เมื่อ STORAGE_BACKEND=drive : fileId ของโฟลเดอร์ราก PhotoSearch/ ใน Shared Drive
DRIVE_ROOT_FOLDER_ID=
# path ของ service account key (mount ตอน deploy — ห้าม commit)
GOOGLE_APPLICATION_CREDENTIALS=

# --- โมเดลใบหน้า ---
# mock = deterministic ทดสอบเส้นทาง (ไม่ใช่ใบหน้าจริง), insightface = โมเดลจริง
EMBEDDER=mock
INSIGHTFACE_MODEL=buffalo_l
INSIGHTFACE_ROOT=~/.insightface
MIN_FACE_PX=24

# --- การค้นหา (ต้องสอบเทียบ threshold กับรูปจริง) ---
MATCH_THRESHOLD=0.35
PAGE_SIZE=20
MAX_RESULTS=500
SEARCH_CACHE_TTL_S=300

# --- แคชรูปย่อใน RAM ---
PREVIEW_CACHE_MB=256
PREVIEW_MAX_EDGE=600

# --- อายุข้อมูลสิทธิ์ (ผลของการถอนรูป) ---
PERMISSION_TTL_S=60

# --- ขอบเขตทรัพยากร ---
SEARCH_CONCURRENCY=8
DRIVE_CONCURRENCY=8
SEARCH_QUEUE_MAX=64

# --- auth (token ของแอปเรา — ไม่ใช่ Google credential) ---
ADMIN_TOKEN=
MEDIA_TOKEN_SECRET=เปลี่ยนเป็นค่าสุ่มยาว
MEDIA_TOKEN_TTL_S=3600

# --- หน้าเว็บ (ตั้งให้ API เสิร์ฟหน้าเว็บที่ origin เดียวกัน) ---
WEB_DIST=../web/dist
